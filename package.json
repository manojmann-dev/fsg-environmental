{
  "name": "fsg-environmental-platform",
  "private": true,
  "version": "1.1.0",
  "workspaces": ["web", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace web\" \"npm run dev --workspace server\"",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace server",
    "build": "npm run build --workspace web",
    "lint": "npm run check --workspace server",
    "start": "concurrently -k \"npm run start --workspace web\" \"npm run start --workspace server\"",
    "start:web": "npm run start --workspace web",
    "start:api": "npm run start --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
